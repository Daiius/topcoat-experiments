# Cloudflare Tunnel 越しに開発サーバーを確認するときだけ使う設定（scripts/dev-remote.sh が読む）。
#   cp .env.remote.example .env.remote   # .env.remote は gitignore 対象
#   ./scripts/dev-remote.sh
#
# tunnel の ingress（Public Hostname）は、ホスト名ごとに次へ向ける:
#   NEXTJS_PUBLIC_HOST  -> http://localhost:18101
#   TOPCOAT_PUBLIC_HOST -> http://localhost:18202
# 開発サーバーを公開するので、Cloudflare Access で許可メール限定にしておく。

# Next.js（next dev）。公開ホスト名は allowedDevOrigins に入る（入れないと /_next の dev 資源と HMR が弾かれる）
NEXTJS_PORT=18101
NEXTJS_PUBLIC_HOST=topcoat-practice-next.example.com

# topcoat（topcoat dev）。127.0.0.1 で待ち受ける
TOPCOAT_PORT=18202
TOPCOAT_PUBLIC_HOST=topcoat-practice-topcoat.example.com
